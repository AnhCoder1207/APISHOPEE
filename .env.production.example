APP_NAME=Camlink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=camlink
DB_USERNAME=camlink_app
DB_PASSWORD=change-this-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SHOPEE_BASE_API=https://affiliate.shopee.vn/api/v3
SHOPEE_TIMEOUT=20
SHOPEE_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
WEB_SYNC_MAX_PAGES=25
API_RATE_LIMIT=60
STARTER_MONTHLY_QUOTA=2000
API_KEY_PREFIX=clk_live_
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXIES=

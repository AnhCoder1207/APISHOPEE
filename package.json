{
  "name": "camlink-affiliate-saas",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.dev.vars --import tsx src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite --config vite.config.ts build",
    "build:server": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:grant": "node scripts/set-admin.mjs grant",
    "admin:revoke": "node scripts/set-admin.mjs revoke",
    "deploy:cloudflare": "npm run typecheck && npm run build:web && wrangler secret bulk .env.production && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.110.0"
  }
}
